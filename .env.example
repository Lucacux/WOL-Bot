DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id
WOL_INTERFACE=eth0

# ── Servidores ────────────────────────────────────────────────
# Cada servidor: nombre, MAC (para WOL), IP (para ping/SSH) y emoji del panel.
NAME_NAS=NAS
MAC_NAS=00:00:00:00:00:00
IP_NAS=192.168.1.10
EMOJI_NAS=🗄️

NAME_MEDIA=Media Server
MAC_MEDIA=00:00:00:00:00:00
IP_MEDIA=192.168.1.20
EMOJI_MEDIA=📺

# ── Servidor en OTRA VLAN (ej. el hipervisor Proxmox) ─────────
# Dos overrides que los servers locales no necesitan:
#
#   WOL_TARGET_*  manda el magic packet unicast a esa IP en vez de al
#                 broadcast 255.255.255.255, que ningún router reenvía. Pide
#                 del lado del router una ARP permanente para la IP (con la
#                 máquina apagada nadie contesta el ARP) y una regla que deje
#                 pasar UDP/9 desde el host del bot. Vacío = broadcast.
#   PROBE_*       "tcp" sondea con un connect a PROBE_PORT_*; "icmp" hace ping.
#                 Entre VLANs el gateway suele descartar ICMP, y ahí el ping da
#                 siempre "caído" → el failsafe reenvía WOL en loop.
NAME_PROXMOX=Proxmox (pve)
MAC_PROXMOX=00:00:00:00:00:00
IP_PROXMOX=192.168.1.70
EMOJI_PROXMOX=🖥️
WOL_TARGET_PROXMOX=192.168.1.70
PROBE_PROXMOX=tcp
PROBE_PORT_PROXMOX=22

# Franja del Proxmox. A diferencia del resto, arranca con el horario ACTIVO.
WAKE_TIME_PROXMOX=08:00
SHUTDOWN_TIME_PROXMOX=23:00

# ── SSH por servidor (apagado / reinicio remoto) ──────────────
# Media es la credencial base; NAS hereda user/key de Media si no lo pisás.
SSH_USER_MEDIA=youruser
SSH_KEY_MEDIA=/home/youruser/.ssh/id_ed25519_wol
SSH_PORT_MEDIA=22

# Opcionales: solo si el NAS usa otro usuario/clave/puerto que el Media.
SSH_USER_NAS=youruser
SSH_KEY_NAS=/home/youruser/.ssh/id_ed25519_wol
SSH_PORT_NAS=22

# El Proxmox entra con un usuario dedicado cuya clave tiene COMANDO FORZADO:
# el sshd ignora lo que se le mande y ejecuta un wrapper que solo acepta las
# palabras `halt` y `reboot` vía $SSH_ORIGINAL_COMMAND. Por eso el comando no
# es `sudo shutdown -h now` como en el resto. Ver docs/RUNBOOK-proxmox.md.
SSH_USER_PROXMOX=wol-bot
SSH_KEY_PROXMOX=/home/youruser/.ssh/id_ed25519_wol
SSH_PORT_PROXMOX=22
SSH_SHUTDOWN_CMD_PROXMOX=halt
SSH_REBOOT_CMD_PROXMOX=reboot

# ── Failsafe watchdog (auto re-wake dentro de la franja del /schedule) ──
# Aplica por servidor (cada uno con su horario/franja). Todos opcionales;
# estos son los valores por defecto.
FAILSAFE_CHECK_SECS=60       # cadencia del watchdog (1 ping ICMP por ciclo si está ON)
FAILSAFE_CONFIRM_CHECKS=3    # pings fallidos consecutivos para declarar caída (debounce)
FAILSAFE_CONFIRM_GAP=5       # segundos entre pings de confirmación
FAILSAFE_WOL_COOLDOWN=180    # espera tras un WOL antes de reintentar (deja bootear)
FAILSAFE_MAX_FAST_TRIES=3    # intentos rápidos antes de pasar a modo lento
FAILSAFE_SLOW_COOLDOWN=600   # cooldown en modo lento (ej. apagón prolongado)
FAILSAFE_BOOT_GRACE=150      # gracia al entrar en franja / reiniciar el bot

# Máximo aceptado para una reserva de mantenimiento externa. La reserva real
# de Updates-Bot dura menos; este tope evita bloqueos de apagado indefinidos.
MAINTENANCE_MAX_TTL_SECS=21600

# Timeout (segundos) de la sonda TCP y puerto destino del magic packet.
PROBE_TCP_TIMEOUT=3
WOL_DEFAULT_PORT=9
